PORT=8000
PUBLIC_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d
MONGO_URI=mongodb://localhost:27017/taskManager
BCRYPT_ROUNDS=12

